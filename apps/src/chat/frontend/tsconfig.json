{
    "compilerOptions": {
        "target": "es2020",
        "module": "CommonJS",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": true
    },
    "include": ["src"],
    "exclude": ["node_modules, dist"]
}
